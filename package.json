{
	"name": "betterov",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "MOCK_API=1 vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p cron/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"deploy": "npm run build && wrangler deploy && wrangler deploy --config cron/wrangler.jsonc"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260923.1": true
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"firebase": "^12.19.0",
		"jose": "^6.2.12",
		"maplibre-gl": "^6.11.2"
	},
	"description": "Advertentievrije OV-planner die je reis bewaakt en alternatieven geeft als het misgaat.",
	"license": "MIT"
}
