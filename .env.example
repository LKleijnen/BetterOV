# Kopieer naar .env voor lokale ontwikkeling (npm run dev). Niets hiervan is verplicht:
# zonder Firebase draait de app in demo-modus met gegevens alleen in de browser.

# Nepdata in plaats van Transitous/NS (handig zonder internettoegang tot die API's)
# MOCK_API=1

# NS API-key (apiportal.ns.nl, product "Ns-App")
# NS_API_KEY=

# Firebase-webconfig (publiek)
# PUBLIC_FIREBASE_API_KEY=
# PUBLIC_FIREBASE_AUTH_DOMAIN=
# PUBLIC_FIREBASE_PROJECT_ID=
# PUBLIC_FIREBASE_APP_ID=
# PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# PUBLIC_FIREBASE_VAPID_KEY=

# Service account (JSON op één regel of base64) en beheerders
# FIREBASE_SERVICE_ACCOUNT=
# ADMIN_EMAILS=jij@gmail.com
